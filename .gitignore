# API keys and secrets — NEVER commit
# Catches .env, .env.cloud-premium, .env.cloud-quality-oss, .env.cloud-backup, etc.
# .example variants are explicitly excluded (templates without real keys).
.env
.env.*
!.env.example
!.env.*.example
agents/.env
agents/.env.*
!agents/.env.example
!agents/.env.*.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
uv.lock

# MkDocs build output
site/

# macOS
.DS_Store

# IDE
.vscode/
*.swp

# Claude Code internal (settings and memory stay local)
.claude/settings.json
.claude/settings.local.json
.claude/memory/
.claude/plans/
# .claude/commands/ is tracked — project slash commands are project assets
