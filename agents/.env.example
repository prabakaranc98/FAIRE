# Frontier Wiki — Agent System Environment Variables
# Copy this file to .env and fill in your keys.

# ── API Keys ──────────────────────────────────────────────────────────────────

# OpenRouter API — primary backend for all LLM calls
# All writer/reviewer/MVB agents route through OpenRouter for unified model access
# Get your key at: openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-...

# Anthropic API — fallback if OpenRouter is not configured
# Used directly via langchain-anthropic when OPENROUTER_API_KEY is not set
ANTHROPIC_API_KEY=sk-ant-...

# Exa API — semantic search for arXiv, .edu, HuggingFace, engineering blogs
# Get your key at: exa.ai
EXA_API_KEY=...

# ── Agent Model Config ────────────────────────────────────────────────────────
# All LLM calls go through langchain ChatOpenAI. By default we POST to
# OpenRouter (cloud). To run locally instead, set OPENAI_API_BASE to any
# OpenAI-compatible endpoint (MLX, Ollama, vLLM, LMStudio) and change the
# MODEL names below to whatever that server exposes.
# See docs/system/local-mode.md and scripts/local-setup.sh.

# OPTIONAL — point at a local OpenAI-compatible server instead of OpenRouter.
# When unset, all calls go to https://openrouter.ai/api/v1.
# OPENAI_API_BASE=http://127.0.0.1:8080/v1

# Cloud model IDs (OpenRouter format: provider/model-name). Verified 2026-05-26.
# When OPENAI_API_BASE is set, replace these with local model names instead
# (e.g. WRITER_MODEL=mlx-community/Qwen2.5-Coder-32B-Instruct-4bit).
WRITER_MODEL=openai/gpt-5.1-codex-mini
MVB_MODEL=openai/gpt-5.1-codex-mini
REVIEWER_MODEL=openai/gpt-5-mini
CRITIC_MODEL=google/gemini-3.1-flash-lite
RESEARCH_MODEL=google/gemini-3.5-flash
FALLBACK_MODEL=google/gemini-3.1-flash-lite

# ── Wiki Output Config ────────────────────────────────────────────────────────
WIKI_DOCS_DIR=../docs
WIKI_CURRICULUM_DIR=../docs/curriculum
WIKI_ARCS_JSON=../docs/arcs.json

# ── Exa Search Tuning ────────────────────────────────────────────────────────
EXA_NUM_RESULTS_PAPERS=8     # foundational + recent paper search
EXA_NUM_RESULTS_SOTA=6       # SotA search (2024+ papers only)
EXA_NUM_RESULTS_PROD=5       # engineering blog / production deployment search

# ── Git Config ────────────────────────────────────────────────────────────────
# Agent-driven git commit — committed when reviewer confidence >= GIT_COMMIT_THRESHOLD.
# The agent decides; you set the bar.
# Set GIT_AUTO_COMMIT=false to disable entirely (for testing/dry-runs).
GIT_AUTO_COMMIT=true
GIT_COMMIT_THRESHOLD=0.8        # confidence floor for auto-commit (0.0–1.0)
GIT_AUTO_PUSH=false             # set true to push to origin after each commit
GIT_COMMIT_AUTHOR="Frontier Wiki Agent <wiki-agent@frontier.wiki>"
