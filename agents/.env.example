# Frontier Wiki — Agent System Environment Variables
# Copy this file to .env and fill in your keys.

# ── API Keys ──────────────────────────────────────────────────────────────────

# OpenRouter API — primary backend for all LLM calls
# All writer/reviewer/MVB agents route through OpenRouter for unified model access
# Get your key at: openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-...

# Anthropic API — fallback if OpenRouter is not configured
# Used directly via langchain-anthropic when OPENROUTER_API_KEY is not set
ANTHROPIC_API_KEY=sk-ant-...

# Exa API — semantic search for arXiv, .edu, HuggingFace, engineering blogs
# Get your key at: exa.ai
EXA_API_KEY=...

# ── Agent Model Config ────────────────────────────────────────────────────────
# All model IDs are OpenRouter format: provider/model-name
# Verified on OpenRouter 2026-05-25

# Maximum intelligence — rich prose, accurate citations, nuanced pedagogy
WRITER_MODEL=anthropic/claude-opus-4.7

# Same as writer — MVB recipes require same level of precision
MVB_MODEL=anthropic/claude-opus-4.7

# Strong structured reasoning — schema compliance, source policy, hallucination detection
# Upgraded from gemini-2.5-pro → gemini-3.1-pro-preview (newer, 1M context)
REVIEWER_MODEL=google/gemini-3.1-pro-preview

# Fast + capable — used for the research/search planning step (cheaper, still strong)
RESEARCH_MODEL=google/gemini-3.5-flash

# High quality fallback — used when Opus is unavailable or for simple tasks
FALLBACK_MODEL=anthropic/claude-sonnet-4.6

# ── Wiki Output Config ────────────────────────────────────────────────────────
WIKI_DOCS_DIR=../docs
WIKI_CURRICULUM_DIR=../docs/curriculum
WIKI_ARCS_JSON=../docs/arcs.json

# ── Exa Search Tuning ────────────────────────────────────────────────────────
EXA_NUM_RESULTS_PAPERS=8     # foundational + recent paper search
EXA_NUM_RESULTS_SOTA=6       # SotA search (2024+ papers only)
EXA_NUM_RESULTS_PROD=5       # engineering blog / production deployment search

# ── Git Config ────────────────────────────────────────────────────────────────
# Set to true to auto-commit after each successful page generation
# Set to false during testing to avoid polluting git history
GIT_AUTO_COMMIT=false
GIT_COMMIT_AUTHOR="Frontier Wiki Agent <wiki-agent@frontier.wiki>"
