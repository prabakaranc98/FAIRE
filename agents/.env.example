# Frontier Wiki — Agent System Environment Variables
# Copy this file to .env and fill in your keys.

# Anthropic API — writer and reviewer agents
# Writer agent uses claude-opus-4-7 (high-fidelity, pedagogically rich output)
# Reviewer agent uses claude-haiku-4-5 (fast schema compliance checks)
ANTHROPIC_API_KEY=sk-ant-...

# Exa API — semantic search for arXiv, .edu, HuggingFace
# Get your key at: exa.ai
EXA_API_KEY=...

# OpenRouter — optional fallback for writer/reviewer agents
# Allows access to GPT-4o, Gemini, Mistral as alternatives
OPENROUTER_API_KEY=...

# Agent model config (override defaults if needed)
WRITER_MODEL=claude-opus-4-7
REVIEWER_MODEL=claude-haiku-4-5-20251001
MVB_MODEL=claude-opus-4-7

# Wiki output config
WIKI_DOCS_DIR=../docs
WIKI_CURRICULUM_DIR=../docs/curriculum
WIKI_ARCS_JSON=../docs/arcs.json

# Git config (for auto-commit after page generation)
GIT_AUTO_COMMIT=true
GIT_COMMIT_AUTHOR="Frontier Wiki Agent <wiki-agent@frontier.wiki>"
