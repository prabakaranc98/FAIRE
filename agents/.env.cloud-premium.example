# Frontier Wiki — CLOUD PREMIUM profile (proven recipe from 9 shipped pages)
# Copy this to agents/.env-cloud-premium (real keys), or use it as a template
# for agents/.env directly:
#   cp agents/.env.cloud-premium.example agents/.env
# Fill in OPENROUTER_API_KEY and EXA_API_KEY below, then restart:
#   ./start.sh --interval 1 --run-now

# ── API Keys (FILL IN YOUR REAL VALUES) ──────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-REPLACE-WITH-YOUR-KEY
EXA_API_KEY=REPLACE-WITH-YOUR-EXA-KEY

# ── Premium closed stack — the one that produced the 9 cloud-shipped pages ──
# Writer/MVB: coding-specialized — LaTeX, markdown, code recipes, real HF IDs
WRITER_MODEL=openai/gpt-5.1-codex-mini
MVB_MODEL=openai/gpt-5.1-codex-mini
# Reviewer: GPT-5 reasoning class — structured rubric + critique
REVIEWER_MODEL=openai/gpt-5-mini
# Critic: cheap parallel fanout (8 critics, non-reasoning)
CRITIC_MODEL=google/gemini-3.1-flash-lite
# Research: fast synthesizer for plan + scratch_pad
RESEARCH_MODEL=google/gemini-3.5-flash
# Fallback: non-reasoning when budget enters reduced mode
FALLBACK_MODEL=google/gemini-3.1-flash-lite

# Per-page cost (incl. revisions): ~$0.40
# $30 top-up = ~75-80 quality pages

# ── Wiki Output ──────────────────────────────────────────────────────────
WIKI_DOCS_DIR=../docs
WIKI_CURRICULUM_DIR=../docs/curriculum
WIKI_ARCS_JSON=../docs/arcs.json

# ── Exa Search ───────────────────────────────────────────────────────────
EXA_NUM_RESULTS_PAPERS=8
EXA_NUM_RESULTS_SOTA=6
EXA_NUM_RESULTS_PROD=5

# ── Git ──────────────────────────────────────────────────────────────────
GIT_AUTO_COMMIT=true
GIT_COMMIT_THRESHOLD=0.7
GIT_AUTO_PUSH=true

# ── Parallelism (cloud handles 4 parallel pages fine) ───────────────────
SPRINT_WORKERS=4
RESEARCH_WORKERS=7

# ── Budget ───────────────────────────────────────────────────────────────
# After your top-up: anchor cap at (current OpenRouter usage + your top-up).
# Check current usage:  curl localhost:8765/budget
# Then set:  BUDGET_LIMIT_USD = usage_usd + 30
BUDGET_LIMIT_USD=85.0

# ── DO NOT set the local-mode trim knobs in cloud mode ──────────────────
# CRITIC_PANEL_DISABLE=  # leave unset; the 8-critic panel is the quality gate
# SCHEMA_PROMPT_BYTES=   # use default 12000
# SCRATCH_PAD_BYTES=     # use default 20000
